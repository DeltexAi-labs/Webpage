# Public address used for canonical metadata after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Deltech contact details.
NEXT_PUBLIC_CONTACT_EMAIL=deltex@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=0793472960

# Optional: enables the "Book a consultation" calls to action.
NEXT_PUBLIC_BOOKING_URL=

# Server-only Nodemailer settings. For Gmail, SMTP_PASS must be a Google App Password,
# never the normal account password. Keep these values in .env.local, not in Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deltex@gmail.com
SMTP_PASS=
CONTACT_TO_EMAIL=deltex@gmail.com
