# Public address used for canonical metadata, sitemap, and Open Graph cards.
# Falls back to the deployed URL below when unset.
NEXT_PUBLIC_SITE_URL=https://webpage-ten-kappa.vercel.app

# Public contact details.
NEXT_PUBLIC_CONTACT_EMAIL=dlandbigtechnologies@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=0793472960

# Optional: enables the "Book a consultation" calls to action.
NEXT_PUBLIC_BOOKING_URL=

# Server-only Nodemailer settings. For Gmail, SMTP_PASS must be a Google App Password,
# never the normal account password. Keep these values in .env.local, not in Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dlandbigtechnologies@gmail.com
SMTP_PASS=
CONTACT_TO_EMAIL=dlandbigtechnologies@gmail.com

# Groq assistant: powers the site chatbot.
# This file is committed — never put a real key here. Put it in .env.local instead.
# Without GROQ_API_KEY the widget still renders but answers with a "not configured" message.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Flood protection and traffic alerts.
# SECURITY_ALERT_SECRET authenticates the middleware -> alert-route call. Generate a random value;
# when it is unset, no alert emails are sent at all.
SECURITY_ALERT_SECRET=
SECURITY_ALERT_TO=dlandbigtechnologies@gmail.com
# Requests per IP inside SHIELD_WINDOW_MS before that IP is blocked for SHIELD_BLOCK_MS.
SHIELD_WINDOW_MS=10000
SHIELD_MAX_REQUESTS=60
SHIELD_BLOCK_MS=60000
# Blocked IPs seen together before it is reported as a coordinated attack.
SHIELD_ATTACK_OFFENDERS=3
SHIELD_ALERT_COOLDOWN_MS=900000
